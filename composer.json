{
  "name": "contao-dd/advanced-classes-bundle",
  "type": "contao-bundle",
  "description": "Extend the CSS classes of Contao content elements and form fields with predefined sets (Bootstrap, Bulma, Materialize, Spectre)",
  "keywords": [
    "contao",
    "bundle",
    "css",
    "classes",
    "bootstrap",
    "bulma",
    "materialize",
    "spectre",
    "grid"
  ],
  "license": "LGPL-3.0-or-later",
  "authors": [
    {
      "name": "Contao Stammtisch Dresden",
      "homepage": "https://www.gondao.de",
      "role": "Developer",
      "email": "kontakt@gondao.de"
    }
  ],
  "support": {
    "email": "develop@pdir.de",
    "issues": "https://github.com/contao-dd/advanced-classes-bundle/issues",
    "source": "https://github.com/contao-dd/advanced-classes-bundle"
  },
  "require": {
    "php": "^8.1",
    "contao/core-bundle": "^5.3 || ^6.0",
    "doctrine/dbal": "^3.6 || ^4.0",
    "symfony/config": "^6.4 || ^7.0 || ^8.0",
    "symfony/dependency-injection": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-foundation": "^6.4 || ^7.0 || ^8.0",
    "symfony/http-kernel": "^6.4 || ^7.0 || ^8.0"
  },
  "conflict": {
    "contao/manager-plugin": "<2.0 || >=3.0"
  },
  "suggest": {
    "contao/news-bundle": "Use advanced classes in content elements of news",
    "contao/calendar-bundle": "Use advanced classes in content elements of events"
  },
  "require-dev": {
    "contao/manager-plugin": "^2.0",
    "contao/easy-coding-standard": "^7.1",
    "phpunit/phpunit": "^9.5",
    "symfony/phpunit-bridge": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "ContaoDD\\AdvancedClassesBundle\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ContaoDD\\AdvancedClassesBundle\\Tests\\": "tests/"
    }
  },
  "extra": {
    "contao-manager-plugin": "ContaoDD\\AdvancedClassesBundle\\ContaoManager\\Plugin"
  },
  "config": {
    "allow-plugins": {
      "contao-components/installer": true,
      "contao/manager-plugin": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  }
}
